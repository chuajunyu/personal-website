---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Chua Jun Yu — Personal Facts",
    description = "Personal site for Chua Jun Yu, served as a nutrition label.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
