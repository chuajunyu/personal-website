---
interface SkillItem {
    name: string;
    pct: number;
}

interface SkillLink {
    label: string;
    href: string;
}

interface Props {
    items: SkillItem[];
    links?: SkillLink[];
    heading?: string;
    rightLabel?: string;
}

const {
    items,
    links = [],
    heading = "Skills & Misc",
    rightLabel = "% Proficiency",
} = Astro.props;
---

<section class="skills">
    <div class="skills__header">
        <span>{heading}</span>
        <span>{rightLabel}</span>
    </div>
    <!-- <p class="skills__list">
        {
            items.map((item, idx) => (
                <>
                    {idx > 0 && <span aria-hidden="true"> • </span>}
                    <span>
                        {item.name} <span class="pct">{item.pct}%</span>
                    </span>
                </>
            ))
        }
    </p> -->
    {
        links.length > 0 && (
            <p class="skills__links">
                {links.map((link, idx) => (
                    <>
                        {idx > 0 && <span aria-hidden="true">•</span>}
                        <a href={link.href}>{link.label}</a>
                    </>
                ))}
            </p>
        )
    }
</section>
