---
interface Props {
    body?: string;
}

const { body } = Astro.props;
---

<section class="current">
    <div class="row">
        <span class="section-header">About Me</span>
        <!-- <span class="amount-header">me</span> -->
    </div>
    {
        body ? (
            <p class="current__body current__body--plain">{body}</p>
        ) : (
            <div class="current__body">
                <slot />
            </div>
        )
    }
</section>
