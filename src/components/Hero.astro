---
interface Props {
    name: string;
    subheading: string;
    servingSize: string;
    calories: string;
}

const { name, subheading, servingSize, calories } = Astro.props;
---

<header class="hero">
    <p class="hero__subheading">{subheading}</p>
    <h1 class="hero__name">{name}</h1>
    <p class="hero__serving">Serving Size: {servingSize}</p>
    <div class="calories-row">
        <span class="calories-row__label">Currently</span>
        <span class="calories-row__value">{calories}</span>
    </div>
</header>
