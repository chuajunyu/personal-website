---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Current from "../components/Current.astro";
import Experience from "../components/Experience.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import Contact from "../components/Contact.astro";
import FooterNote from "../components/FooterNote.astro";

const birdguessrUrl = "https://guessbirdbysong.netlify.app";

interface ExperienceEntry {
    org: string;
    meta: string;
    bullets?: string[];
    orgHref?: string;
}

const servingSize = "1 human";
const calories = "CS @ NUS";

const workExperiences: ExperienceEntry[] = [
    {
        org: "TikTok / ByteDance",
        meta: "Software Engineering Intern · 2025",
        orgHref: "https://www.bytedance.com/en/",
    },
    {
        org: "Hypotenuse AI",
        meta: "Software Engineering Intern · 2025",
        orgHref: "https://hypotenuse.ai/",
    },
    {
        org: "GovTech",
        meta: "Software Engineering Intern · 2024",
        orgHref: "https://www.tech.gov.sg",
    },
    {
        org: "Digital and Intelligence Service",
        meta: "Software Engineer (Conscript) · 2021–2023",
        orgHref: "https://www.dis.gov.sg/",
    },
];

const nusExperiences: ExperienceEntry[] = [
    {
        org: "NUS Hackers",
        meta: "Coreteam Member",
        orgHref: "https://www.nushackers.org/",
    },
    {
        org: "Teaching Assistant (School of Computing)",
        meta: "NUS",
        bullets: [
            "Data Structures & Algorithms (twice)",
            "Introduction to Programming",
            "Introduction to Operating Systems (Lab)",
        ],
    },
];

const contactLinks = [
    { label: "GitHub", href: "https://github.com/chuajunyu" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/chua-jun-yu/" },
];

const footerText = "* Reach me at chuajunyu1 [at] gmail.com.";
---

<Layout title="Chua Jun Yu — Personal Facts">
    <main class="label">
        <Hero
            name="Chua Jun Yu"
            subheading="Personal Facts"
            servingSize={servingSize}
            calories={calories}
        />
        <div class="rule-thick"></div>
        <Current>
            <p>
                Hi, I'm Jun Yu. I'm a computer science student
                at the National University of Singapore. Recently,
                I've been learning more about databases, operating systems
                and how they work under the hood.
            </p>
            <p>
                Recently, I've been developing a growing interest in
                wildlife and biodiversity, which is what led me to build
                <a href={birdguessrUrl}>a bird guessing game</a>. I also enjoy learning
                about metaphysics and philosophy, and I'm currently reading
                <a href="https://en.wikipedia.org/wiki/A_Brief_History_of_Time"
                    >A Brief History of Time</a
                >.
            </p>
        </Current>
        <div class="rule-thick"></div>
        <Experience heading="Experience">
            {
                workExperiences.map((exp) => (
                    <ExperienceRow
                        org={exp.org}
                        meta={exp.meta}
                        bullets={exp.bullets}
                        orgHref={exp.orgHref}
                    />
                ))
            }
        </Experience>
        <div class="rule-thick"></div>
        <Experience heading="NUS" rightLabel="Role">
            {
                nusExperiences.map((exp) => (
                    <ExperienceRow
                        org={exp.org}
                        meta={exp.meta}
                        bullets={exp.bullets}
                        orgHref={exp.orgHref}
                    />
                ))
            }
        </Experience>
        <div class="rule-medium"></div>
        <Contact links={contactLinks} />
        <div class="rule-medium"></div>
        <FooterNote text={footerText} />
    </main>
</Layout>
